{
  "name": "aqa-intern-challenge",
  "version": "1.0.0",
  "description": "Автотесты виджета поддержки Учи.ру для задания AQA Intern Challenge",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report --host 127.0.0.1",
    "typecheck": "tsc --noEmit && node --check scripts/docker-report.cjs && node --check scripts/check-playwright-version.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && node scripts/check-playwright-version.cjs"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.13.8",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
